TURNO=1

# Fonte dos dados. Para o TSE (confirmar o código da eleição no ele-c.json antes):
# FONTE_URL_TEMPLATE=https://resultados.tse.jus.br/oficial/ele2026/{eleicao}/dados-simplificados/{abr}/{abr}-c0001-e{eleicao6}-r.json
# FONTE_NOME=tse
INTERVALO_COLETA_MS=5000

# Simulador
SIM_DURACAO_S=900
SIM_INTERVALO_GERACAO_S=10
FALHA_TAXA_5XX=0.02
FALHA_TAXA_INCONSISTENTE=0.005

# Credenciais locais (em produção vêm de um gerenciador de segredos)
